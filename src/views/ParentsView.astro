---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SubNav from '../components/SubNav.astro';
import Rich from '../components/Rich.astro';
import Icon from '../components/Icon.astro';
import CalendarSection from '../components/CalendarSection.astro';
import { getPage, settings, type Lang, tr } from '../lib/content';
import { asset } from '../lib/paths';
import { rich, paragraphs, real } from '../lib/text';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
// Uniform photos: every image in brand/uniform, in file-name order.
const uniformFiles = import.meta.glob<{ default: ImageMetadata }>('/brand/uniform/*.{jpg,jpeg,png,webp}', { eager: true });
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = getPage('parents', lang);
const portal = settings.links.parentPortal;
const uniformPhotos = Object.keys(uniformFiles).sort().map((k, i) => ({ img: uniformFiles[k].default, caption: (p.uniform?.photos ?? [])[i] ?? p.uniform?.title ?? '' }));
const [uniformMain, ...uniformItems] = uniformPhotos;
---
<BaseLayout title={p.seo.title} description={p.seo.description} lang={lang}>
  <PageHero title={p.hero.title} text={p.hero.text}>
    <div class="btn-row" style="margin-block-start:2rem">
      <a class="btn btn--gold" href="#calendar"><Icon name="calendar" size={18} /> {tr('Academic calendar', lang)}</a>
      {portal && <a class="btn btn--outline-light" href={portal} rel="noopener"><Icon name="lock" size={18} /> {p.portal.button}</a>}
    </div>
  </PageHero>
  <SubNav items={[['#calendar', tr('Calendar', lang)], ...(p.uniform && real(p.uniform.text) ? [['#uniform', tr('Uniform', lang)]] : []), ['#together', tr('Working together', lang)], ['#policies', tr('Policies', lang)], ...(portal ? [['#portal', tr('Parent Portal', lang)]] : [])] as [string, string][]} />

  <CalendarSection lang={lang} />

  {p.uniform && real(p.uniform.text) && (
  <section class="section section--alt" id="uniform" aria-labelledby="uni-h">
    <div class="container">
      <div class="split">
        <div class="reveal">
          <p class="eyebrow">{tr('Every day', lang)}</p>
          <h2 id="uni-h">{p.uniform.title}</h2>
          <div class="body">{paragraphs(p.uniform.text).map((t) => <p set:html={rich(t)} />)}</div>
        </div>
        {uniformMain ? (
          <figure class="uni-main reveal">
            <Image src={uniformMain.img} alt={uniformMain.caption} widths={[480, 800, 1200]} sizes="(min-width: 960px) 50vw, 92vw" />
          </figure>
        ) : (
          <div class="swatches reveal" aria-hidden="true">
            <div class="shirt girls"><span class="crest">B</span><p>{tr('Girls', lang)}</p><small>{tr('School uniform', lang)}</small></div>
            <div class="shirt boys"><span class="crest">B</span><p>{tr('Boys', lang)}</p><small>{tr('School uniform', lang)}</small></div>
          </div>
        )}
      </div>
      {uniformItems.length > 0 && (
        <ul class="uni-items" role="list">
          {uniformItems.map((u) => (
            <li class="reveal">
              <figure>
                <Image src={u.img} alt={u.caption} widths={[300, 500, 800]} sizes="(min-width: 960px) 23vw, (min-width: 560px) 45vw, 92vw" />
                <figcaption>{u.caption}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
  )}

  <section class="section" id="together" aria-labelledby="tog-h">
    <div class="container">
      <div class="section-head"><p class="eyebrow">{tr('Partnership', lang)}</p><h2 id="tog-h">{p.partnership.title}</h2></div>
      <div class="grid grid--3">
        {p.partnership.items.map((it: any) => <article class="card card--gold-top reveal"><h3>{it.title}</h3><Rich as="p" text={it.text} /></article>)}
      </div>
    </div>
  </section>

  <section class="section section--alt" id="policies" aria-labelledby="pol-h">
    <div class="narrow">
      <div class="section-head"><p class="eyebrow">{tr('Policies', lang)}</p><h2 id="pol-h">{p.policies.title}</h2><Rich as="p" text={p.policies.intro} /></div>
      <ul class="policies" role="list">
        {p.policies.items.map((pol: any) => (
          <li>
            <Icon name="file" size={22} />
            {pol.pdf ? <a href={asset(`files/${pol.pdf}`)}><Rich text={pol.title} /></a> : <Rich text={pol.title} />}
          </li>
        ))}
      </ul>
    </div>
  </section>

  {portal && <section class="section section--navy" id="portal" aria-labelledby="portal-h">
    <div class="narrow center">
      <h2 id="portal-h">{p.portal.title}</h2>
      <p class="lead">{p.portal.text}</p>
      <a class="btn btn--gold" href={portal} rel="noopener">{p.portal.button}</a>
    </div>
  </section>}
</BaseLayout>
<style>
  .body { margin-block-start: 1.25rem; font-size: 1.08rem; }
  .swatches { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  .uni-main { margin: 0; border-radius: var(--radius); overflow: hidden; box-shadow: 0 30px 60px -35px rgba(6,24,51,.55); }
  .uni-main :global(img) { inline-size: 100%; block-size: auto; display: block; }
  .uni-items { list-style: none; padding: 0; margin-block-start: 3rem; display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); }
  @media (max-width: 559px) { .uni-items { grid-template-columns: 1fr 1fr; gap: .75rem; } .uni-items figcaption { font-size: .85rem; padding: .6rem .5rem .75rem; } }
  .uni-items figure { margin: 0; background: #fff; border: 1px solid var(--c-border); border-radius: var(--radius); overflow: hidden; }
  .uni-items :global(img) { inline-size: 100%; block-size: auto; display: block; }
  .uni-items figcaption { padding: .85rem 1rem 1rem; font-weight: 600; color: var(--c-primary); font-size: .97rem; text-align: center; }
  .shirt { border-radius: var(--radius); padding: 2.5rem 1.5rem 1.75rem; text-align: center; display: grid; justify-items: center; gap: .35rem; border: 1px solid var(--c-border); }
  .shirt.girls { background: #fff; color: var(--c-primary); }
  .shirt.boys { background: var(--c-primary); color: #fff; }
  .crest { display: grid; place-items: center; inline-size: 3.25rem; block-size: 3.75rem; clip-path: polygon(0 0, 100% 0, 100% 60%, 50% 100%, 0 60%); background: var(--c-primary); color: var(--c-accent); font: 600 1.5rem/1 var(--font-heading); margin-block-end: 1rem; border: 2px solid var(--c-accent); }
  .boys .crest { background: var(--c-primary-deep); }
  .shirt p { font: 600 1.4rem/1.2 var(--font-heading); }
  .shirt small { font-size: .85rem; opacity: .8; }
  .policies { list-style: none; padding: 0; display: grid; gap: .75rem; }
  .policies li { display: flex; gap: 1rem; align-items: center; background: #fff; border: 1px solid var(--c-border); border-radius: var(--radius); padding: 1.1rem 1.4rem; }
  .policies :global(svg) { color: var(--c-accent-text); flex-shrink: 0; }
  .center { text-align: center; }
  .lead { font-size: 1.15rem; margin-block: 1rem 2rem; color: #D5DCE7; }
</style>
